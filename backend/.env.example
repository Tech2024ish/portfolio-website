# Backend environment. Copy to backend/.env for local development.
# Placeholders only: never commit real values. Production values live in Render's
# environment settings, never in Git.

# ---- runtime: development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# ENABLE_API_DOCS=true             # default: on outside production

# ---- database
# Local: the Docker Compose database (see docker-compose.yml).
# Production: Supabase > Project settings > Database > Session pooler URI.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:54329/portfolio

# Integration tests use a separate database, created automatically by Compose.
TEST_DATABASE_URL=postgresql://portfolio:portfolio@localhost:54329/portfolio_test
EXPECTED_POSTGRES_MAJOR=17

# ---- HTTP boundary
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# ---- owner sessions
COOKIE_SECURE=false                # must be true in production (enforced)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# ---- file storage: local (development only) | supabase
STORAGE_BACKEND=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=               # backend-only secret; never expose to Next.js
MEDIA_BUCKET=media
MAX_IMAGE_MB=8
MAX_DOCUMENT_MB=10

# ---- email (optional; password reset and inbox replies)
RESEND_API_KEY=
MAIL_FROM=Jean Claude Ishimwe <hello@your-verified-domain.com>
MAIL_REPLY_TO=you@example.com

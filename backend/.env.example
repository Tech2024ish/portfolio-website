# Backend environment. Copy to backend/.env for local development.
# Placeholders only: never commit real values. Production values live in Render's
# environment settings, never in Git.

# ---- runtime: development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# ENABLE_API_DOCS=true             # default: on outside production

# ---- database
# Local: the Docker Compose database (see docker-compose.yml).
# Production: Supabase > Project settings > Database > Session pooler URI.
# 127.0.0.1, not localhost: Compose publishes the port on IPv4 loopback only, and on some
# systems (Windows) localhost resolves to ::1 first and every connection stalls until timeout.
DATABASE_URL=postgresql://portfolio:portfolio@127.0.0.1:54329/portfolio

# Integration tests use a separate database, created automatically by Compose.
TEST_DATABASE_URL=postgresql://portfolio:portfolio@127.0.0.1:54329/portfolio_test
EXPECTED_POSTGRES_MAJOR=17

# ---- HTTP boundary
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# Reverse proxies in front of the API that append to X-Forwarded-For (used for rate limiting).
# 0 = ignore the header (safe default). Set only after confirming the real proxy chain in
# production (for example Vercel rewrite + Render router); a too-high value lets clients
# spoof their address and bypass rate limits.
TRUSTED_PROXY_COUNT=0

# ---- public contact form (POST /api/v1/contact)
CONTACT_RATE_LIMIT=5               # messages per client per window
CONTACT_RATE_WINDOW_MINUTES=60

# ---- owner sessions
COOKIE_SECURE=false                # must be true in production (enforced)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# ---- file storage: local (development only) | supabase
STORAGE_BACKEND=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=               # backend-only secret; never expose to Next.js
MEDIA_BUCKET=media
MAX_IMAGE_MB=8
MAX_DOCUMENT_MB=10

# ---- email (optional; password reset and inbox replies)
RESEND_API_KEY=
MAIL_FROM=Jean Claude Ishimwe <hello@your-verified-domain.com>
MAIL_REPLY_TO=you@example.com

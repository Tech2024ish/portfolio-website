# ---- Legacy routes (/api/visits, /api/gallery) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-key
ENABLE_DEBUG_ENDPOINTS=false

# ---- v1 API ----
ENVIRONMENT=development            # set to "production" on Render
# Supabase > Project settings > Database > Connection string (session pooler, URI)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5173,https://goslish.vercel.app
PUBLIC_SITE_URL=https://goslish.vercel.app
COOKIE_SECURE=false                # true (default) in production
SESSION_TTL_HOURS=12

# File storage: "local" for development, "supabase" in production
STORAGE_BACKEND=local
SUPABASE_SERVICE_KEY=              # server-side only; never expose to the frontend
MEDIA_BUCKET=media                 # create as a PUBLIC bucket in Supabase Storage
MAX_IMAGE_MB=8
MAX_DOCUMENT_MB=10

# Email replies via Resend (https://resend.com). Leave blank to disable sending;
# replies are then saved with status "not_configured" and never shown as sent.
RESEND_API_KEY=
MAIL_FROM=Jean Claude Ishimwe <hello@your-verified-domain.com>
MAIL_REPLY_TO=claudeish88@gmail.com

# Frontend environment. Copy to frontend/.env.local for local development.
# Placeholders only. Nothing here is secret: Next.js never receives backend secrets.

# Server-only: where Next.js proxies /api/* and where Server Components fetch from.
# Local: the FastAPI dev server (or http://127.0.0.1:18000 for the Compose container).
# Use 127.0.0.1, not localhost: uvicorn listens on IPv4 loopback, and localhost may resolve to
# ::1 first, where a different local service can answer.
# Production (Vercel): the Render service URL, e.g. https://portfolio-api.onrender.com
API_ORIGIN=http://127.0.0.1:8000

# Public: canonical site origin for metadata, Open Graph and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Added in Phase 10 (server-only): REVALIDATE_SIGNING_SECRET for the signed cache-refresh hook.

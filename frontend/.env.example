# Frontend environment. Copy to frontend/.env.local for local development.
# Placeholders only. Nothing here is secret: Next.js never receives backend secrets.

# Server-only: where Next.js proxies /api/* and where Server Components fetch from.
# Local: the FastAPI dev server on port 8100 (see backend/README.md), or
# http://127.0.0.1:18000 for the Compose container. Port 8100 avoids uvicorn's default 8000,
# which other local projects commonly occupy.
# Use 127.0.0.1, not localhost: uvicorn listens on IPv4 loopback, and localhost may resolve to
# ::1 first, where a different local service can answer.
# Production (Vercel): the Render service URL, e.g. https://portfolio-api.onrender.com
API_ORIGIN=http://127.0.0.1:8100

# Server only, never NEXT_PUBLIC_. Same value as TRUSTED_PROXY_SECRET on the API: marks requests
# that came through this site, so the API can trust their X-Forwarded-For.
TRUSTED_PROXY_SECRET=

# Public: canonical site origin for metadata, Open Graph, structured data and the sitemap.
# Optional on Vercel: without it, the project's production domain is used
# (VERCEL_PROJECT_PRODUCTION_URL). Set it for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: where public pages get their content.
#   bundled (default): src/content/profile.ts, compiled into the site.
#   api: the FastAPI public API, edited in the Owner Studio. The API must be reachable at build time.
PUBLIC_CONTENT_SOURCE=bundled

# Server-only secret for POST /api/revalidate (signed cache refresh from FastAPI). The same value as
# the backend's REVALIDATE_SIGNING_SECRET, at least 32 random characters. Empty: the route answers 404.
REVALIDATE_SIGNING_SECRET=
